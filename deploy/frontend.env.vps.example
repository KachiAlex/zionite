# Frontend Environment Variables for VPS deployment
# Copy to .env.production and set your VPS domain
# Then rebuild: npm run build

# Point to your VPS backend instead of Fly.io
VITE_API_BASE=https://api.yourdomain.com
VITE_STREAM_BASE=https://api.yourdomain.com
VITE_SOCKET_BASE=https://api.yourdomain.com
