# ─────────────────────────────────────────────────────────────────────
# Zionite VPS Deployment — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_DB=zionite
POSTGRES_USER=zionite
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password

# ── Security ────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_random_64_char_string

# ── Frontend URL ────────────────────────────────────────────────────
FRONTEND_URL=https://www.zionite.online

# ── CORS Allowed Origins (comma-separated) ──────────────────────────
ALLOWED_ORIGINS=https://www.zionite.online,http://localhost:5173

# ── Cloudflare R2 Storage ───────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=zionite
R2_PUBLIC_URL=https://pub-65e1bfa308d049a98f14e848e0dfd516.r2.dev
R2_WORKER_URL=https://r2-upload-worker.zionite-r2.workers.dev

# ── Email (Brevo SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login
SMTP_PASS=your_brevo_smtp_key
SMTP_SECURE=false
FROM_EMAIL=noreply@zionite.online
FROM_NAME=ZioniteFM

# ── Firebase Push Notifications ─────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# ── Web Push (VAPID Keys) ───────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@zionite.online

# ── Sentry Error Tracking (optional) ────────────────────────────────
SENTRY_DSN=

# ── Domain for SSL certificate ──────────────────────────────────────
DOMAIN=api.zionite.online
